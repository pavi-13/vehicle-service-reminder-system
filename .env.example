# Use a long random secret before deployment
APP_SECRET=replace-with-a-long-random-secret
DEBUG=false

# Supabase Realtime. Keep SERVICE_ROLE_KEY on the server only; never put it in
# static JavaScript or commit it to Git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: enables OpenAI-powered chat. Without this, built-in help works free.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Local-only SQLite file. On Vercel, use a managed database before production launch.
DB_PATH=C:\\path\\to\\vehiclecare.db
# Secure the Vercel daily reminder call.
CRON_SECRET=replace-with-another-long-secret
# Optional SMTP email delivery (Gmail app password / Brevo / Zoho, etc.)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional Twilio SMS delivery. Phone numbers should include country code (e.g. +919876543210).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
